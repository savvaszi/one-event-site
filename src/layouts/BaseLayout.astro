---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'One Event Greece & Cyprus — Destination Management Services. We create moments that inspire.',
} = Astro.props;

const ogImage =
  'https://one-event.gr/wp-content/uploads/2022/04/santorini.jpg';

const htmlClass =
  typeof window === 'undefined' ? 'no-js' : '';
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://one-event.gr" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduced-motion');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduced) {
        gsap.registerPlugin(ScrollTrigger);

        const lenis = new Lenis({ duration: 1.15 });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        const heroTitle = document.querySelector('.hero-title');
        if (heroTitle) {
          const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
          tl.from('.hero-eyebrow', { y: 24, autoAlpha: 0, duration: 0.9 }, 0.2)
            .from(heroTitle, { yPercent: 30, autoAlpha: 0, filter: 'blur(10px)', duration: 1.5 }, 0.35)
            .from('.hero-scroll', { autoAlpha: 0, y: 16, duration: 0.9 }, 1);
        }

        document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
          const withBreaks = el.innerHTML.replace(/<br\s*\/?>/gi, '\u0001');
          const text = withBreaks.replace(/<[^>]+>/g, '');
          const parts = text.split(/\s+/).filter(Boolean);
          el.innerHTML = parts
            .map((w) => {
              const brk = w.includes('\u0001');
              return `${brk ? '<br>' : ''}<span class="w"><span>${w.replaceAll('\u0001', '')}</span></span>`;
            })
            .join(' ');
          gsap.from(el.querySelectorAll('.w > span'), {
            yPercent: 110,
            rotate: 3,
            duration: 1.1,
            ease: 'power4.out',
            stagger: 0.035,
            scrollTrigger: { trigger: el, start: 'top 82%' },
          });
        });

        document.querySelectorAll('[data-reveal]').forEach((el, i) => {
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 1.15,
            ease: 'power3.out',
            delay: (i % 4) * 0.08,
            scrollTrigger: { trigger: el, start: 'top 86%' },
          });
        });

        document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
          const depth = parseFloat(el.dataset.parallax || '18');
          gsap.fromTo(
            el,
            { yPercent: -depth / 2 },
            {
              yPercent: depth / 2,
              ease: 'none',
              scrollTrigger: { trigger: el.closest('section, figure') ?? el, scrub: true },
            },
          );
        });

        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = parseInt(el.dataset.count!, 10);
          const obj = { v: 0 };
          gsap.to(obj, {
            v: target,
            duration: 2,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 88%' },
            onUpdate: () => {
              el.textContent = Math.round(obj.v).toLocaleString('en-US');
            },
          });
        });

        const track = document.querySelector<HTMLElement>('[data-hscroll-track]');
        const section = document.querySelector<HTMLElement>('[data-hscroll]');
        if (track && section && innerWidth > 900) {
          const distance = () => Math.max(0, track.scrollWidth - innerWidth);
          const applyHeight = () => {
            if (innerWidth > 900) section.style.height = `${innerHeight + distance()}px`;
            else section.style.height = '';
          };
          applyHeight();
          ScrollTrigger.addEventListener('refreshInit', applyHeight);
          gsap.to(track, {
            x: () => -distance(),
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top top',
              end: 'bottom bottom',
              scrub: 1,
              invalidateOnRefresh: true,
            },
          });
        }

        document.querySelectorAll<HTMLAnchorElement>('[data-magnetic]').forEach((el) => {
          const strength = 22;
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = e.clientX - r.left - r.width / 2;
            const y = e.clientY - r.top - r.height / 2;
            gsap.to(el, { x: (x / r.width) * strength, y: (y / r.height) * strength, duration: 0.5, ease: 'power3.out' });
          });
          el.addEventListener('mouseleave', () => {
            gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
          });
        });

        const manifestoWrap = document.querySelector<HTMLElement>('[data-manifesto]');
        const items = gsap.utils.toArray<HTMLElement>('.manifesto-item');
        if (manifestoWrap && items.length > 1 && innerWidth > 900) {
          gsap.set(items.slice(1), { autoAlpha: 0, scale: 1.06, filter: 'blur(8px)' });
          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: manifestoWrap,
              start: 'top top',
              end: 'bottom bottom',
              scrub: 0.6,
              invalidateOnRefresh: true,
            },
          });
          items.forEach((item, i) => {
            if (i < items.length - 1) {
              tl.to(item, { autoAlpha: 0, scale: 0.95, filter: 'blur(8px)', ease: 'power2.inOut' })
                .to(items[i + 1], { autoAlpha: 1, scale: 1, filter: 'blur(0px)', ease: 'power2.inOut' }, '<0.2');
            }
          });
        }

        addEventListener('load', () => ScrollTrigger.refresh());
      }
    </script>
  </body>
</html>
