---
const { project, labels } = Astro.props;
const caption = (index: number) => `${project.title} · ${labels.photo} ${index + 1}/${project.gallery.length}`;
---

<section class="gallery" aria-labelledby="project-gallery-title" data-localized-gallery>
  <div class="wrap">
    <h2 class="display-md" id="project-gallery-title">{labels.photographs}</h2>
    <div class="gallery-grid">
      {project.gallery.map((src: string, index: number) => (
        <a href={src} data-caption={caption(index)} aria-label={`${labels.openPhoto} ${index + 1}`}>
          <img src={src} alt={caption(index)} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </div>
  <dialog aria-label={labels.photographs}>
    <figure>
      <button class="close" type="button" data-close aria-label={labels.close}>×</button>
      <button type="button" data-previous aria-label={labels.previousPhoto}>‹</button>
      <img alt="" />
      <button type="button" data-next aria-label={labels.nextPhoto}>›</button>
      <figcaption aria-live="polite"></figcaption>
    </figure>
  </dialog>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-localized-gallery]');
  const dialog = gallery?.querySelector('dialog');
  const image = dialog?.querySelector('img');
  const caption = dialog?.querySelector('figcaption');

  if (gallery && dialog && image && caption) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('.gallery-grid a')];
    let index = 0;
    let opener: HTMLAnchorElement;

    const showPhoto = (nextIndex: number) => {
      index = (nextIndex + links.length) % links.length;
      const link = links[index];
      image.src = link.href;
      image.alt = link.dataset.caption ?? '';
      caption.textContent = image.alt;
    };

    links.forEach((link, photoIndex) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        showPhoto(photoIndex);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-previous]')?.addEventListener('click', () => showPhoto(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => showPhoto(index + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showPhoto(index - 1);
      if (event.key === 'ArrowRight') showPhoto(index + 1);
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .gallery {
    padding-block: clamp(3rem, 8vw, 6rem);
    border-block-start: 1px solid var(--line);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .gallery-grid a {
    overflow: hidden;
    border-radius: 12px;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 25%;
  }

  dialog {
    position: fixed;
    inset: 0;
    max-width: min(92vw, 1200px);
    margin: auto;
    color: #fff;
    background: #161616;
    border: 0;
    border-radius: 12px;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, .84);
  }

  dialog figure {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .25rem;
    padding: 2.75rem .25rem .75rem;
  }

  dialog img {
    max-height: 72vh;
    margin-inline: auto;
    object-fit: contain;
  }

  dialog button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.6rem;
    cursor: pointer;
  }

  .close {
    position: absolute;
    inset: 0 .5rem auto auto;
  }

  figcaption {
    grid-column: 1 / -1;
    padding: .35rem .75rem;
    text-align: center;
  }
</style>
