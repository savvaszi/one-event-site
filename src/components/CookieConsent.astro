---
import { localizePath, type Locale } from '../data/i18n';

const { locale }: { locale: Locale } = Astro.props;
const copy = {
  en: {
    preferences: 'Cookie preferences', title: 'Cookies',
    intro: 'We use essential cookies to run this site. With your permission, Google Analytics measures visits and how people use the site.',
    privacy: 'Privacy policy', settings: 'Settings', reject: 'Reject all', accept: 'Accept',
    back: 'Back', save: 'Save preferences',
    necessary: ['Necessary', 'Essential for core functionality and security. Always enabled.'],
    functional: ['Functional', 'Enhanced features such as social media sharing.'],
    performance: ['Performance & Analytics', 'Allows Google Analytics to measure visits and website use.'],
    advertisement: ['Advertisement', 'Used to deliver relevant ads and campaigns.'],
  },
  el: {
    preferences: 'Προτιμήσεις cookies', title: 'Cookies',
    intro: 'Χρησιμοποιούμε απαραίτητα cookies για τη λειτουργία του ιστοτόπου. Με τη συγκατάθεσή σας, το Google Analytics μετρά τις επισκέψεις και τη χρήση του ιστοτόπου.',
    privacy: 'Πολιτική απορρήτου', settings: 'Ρυθμίσεις', reject: 'Απόρριψη όλων', accept: 'Αποδοχή',
    back: 'Πίσω', save: 'Αποθήκευση προτιμήσεων',
    necessary: ['Απαραίτητα', 'Απαραίτητα για τη λειτουργία και την ασφάλεια του ιστοτόπου. Είναι πάντα ενεργά.'],
    functional: ['Λειτουργικά', 'Επιτρέπουν πρόσθετες λειτουργίες, όπως η κοινοποίηση στα κοινωνικά δίκτυα.'],
    performance: ['Απόδοση και ανάλυση', 'Επιτρέπει στο Google Analytics να μετρά τις επισκέψεις και τη χρήση του ιστοτόπου.'],
    advertisement: ['Διαφήμιση', 'Χρησιμοποιούνται για την προβολή σχετικών διαφημίσεων και καμπανιών.'],
  },
  es: {
    preferences: 'Preferencias de cookies', title: 'Cookies',
    intro: 'Usamos cookies esenciales para el funcionamiento del sitio. Con tu permiso, Google Analytics mide las visitas y el uso del sitio.',
    privacy: 'Política de privacidad', settings: 'Configuración', reject: 'Rechazar todas', accept: 'Aceptar',
    back: 'Volver', save: 'Guardar preferencias',
    necessary: ['Necesarias', 'Esenciales para el funcionamiento y la seguridad del sitio. Siempre activas.'],
    functional: ['Funcionales', 'Habilitan funciones adicionales, como compartir contenido en redes sociales.'],
    performance: ['Rendimiento y analítica', 'Permite a Google Analytics medir las visitas y el uso del sitio.'],
    advertisement: ['Publicidad', 'Se utilizan para mostrar anuncios y campañas relevantes.'],
  },
}[locale];
const categories = ['necessary', 'functional', 'performance', 'advertisement'] as const;
---

<div class="cc-root" id="cookie-consent" data-open="false" hidden>
  <aside class="cc-card" data-lenis-prevent role="dialog" aria-modal="false" aria-label={copy.preferences} aria-describedby="cc-text">
    <header class="cc-head">
      <p class="cc-title">{copy.title}</p>
      <span class="cc-dot" aria-hidden="true"></span>
    </header>

    <div class="cc-view" data-view="banner">
      <p id="cc-text" class="cc-text">
        {copy.intro}
      </p>
      <a class="cc-link" href={localizePath('/privacy-policy/', locale)}>{copy.privacy}</a>
      <div class="cc-actions">
        <button class="cc-btn ghost" type="button" data-cc="settings">{copy.settings}</button>
        <button class="cc-btn ghost" type="button" data-cc="reject">{copy.reject}</button>
        <button class="cc-btn solid" type="button" data-cc="accept">{copy.accept}</button>
      </div>
    </div>

    <div class="cc-view" data-view="settings" hidden>
      <ul class="cc-cats">
        {categories.map((category) => (
          <li>
            <label class="cc-cat">
              <span class="cc-copy">
                <strong>{copy[category][0]}</strong>
                <small>{copy[category][1]}</small>
              </span>
              <input
                type="checkbox"
                data-cat={category}
                checked={category === 'necessary'}
                disabled={category === 'necessary'}
              />
              <span class="cc-switch" aria-hidden="true"><i></i></span>
            </label>
          </li>
        ))}
      </ul>
      <div class="cc-actions">
        <button class="cc-btn ghost" type="button" data-cc="back">{copy.back}</button>
        <button class="cc-btn solid" type="button" data-cc="save">{copy.save}</button>
      </div>
    </div>
  </aside>
</div>

<script>
  import { setGoogleAnalyticsConsent } from '../data/googleAnalytics';

  const ANALYTICS_NOTICE_VERSION = 1;
  const KEY = 'oe-cookie-consent';
  const root = document.getElementById('cookie-consent');
  let unpersistedChoice: Record<string, unknown> | undefined;

  const store = (): Record<string, unknown> => {
    if (unpersistedChoice) return unpersistedChoice;
    try {
      return JSON.parse(localStorage.getItem(KEY) || '{}') ?? {};
    } catch {
      return {};
    }
  };

  const hasAnalyticsConsent = (saved: Record<string, unknown>) =>
    saved.performance === true && saved.analyticsNotice === ANALYTICS_NOTICE_VERSION;

  const views = root!.querySelectorAll<HTMLElement>('.cc-view');
  const setState = (state: 'banner' | 'settings') => {
    root!.dataset.state = state;
    views.forEach((v) => (v.hidden = v.dataset.view !== state));
  };
  const show = () => {
    root!.hidden = false;
    requestAnimationFrame(() => root!.setAttribute('data-open', 'true'));
  };
  const hide = () => {
    root!.setAttribute('data-open', 'false');
    setTimeout(() => (root!.hidden = true), 500);
  };
  const persist = (choices: Record<string, boolean>) => {
    const saved = { ...choices, analyticsNotice: ANALYTICS_NOTICE_VERSION, ts: new Date().toISOString() };
    try {
      localStorage.setItem(KEY, JSON.stringify(saved));
      unpersistedChoice = undefined;
    } catch {
      unpersistedChoice = saved;
    }
    setGoogleAnalyticsConsent(choices.performance === true);
    hide();
  };

  root!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cc]');
    if (!btn) return;
    const action = btn.dataset.cc;
    if (action === 'accept')
      persist({ necessary: true, functional: true, performance: true, advertisement: true });
    else if (action === 'reject')
      persist({ necessary: true, functional: false, performance: false, advertisement: false });
    else if (action === 'settings' || action === 'back') setState(action === 'back' ? 'banner' : 'settings');
    else if (action === 'save') {
      const boxes = root!.querySelectorAll<HTMLInputElement>('input[data-cat]');
      const choices: Record<string, boolean> = {};
      boxes.forEach((b) => (choices[b.dataset.cat!] = b.checked));
      choices.necessary = true;
      persist(choices);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root!.dataset.open === 'true') hide();
  });

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-cookies]')) {
      const saved = store();
      root!.querySelectorAll<HTMLInputElement>('input[data-cat]:enabled').forEach((box) => {
        const category = box.dataset.cat!;
        box.checked = category === 'performance' ? hasAnalyticsConsent(saved) : saved[category] === true;
      });
      setState('settings');
      show();
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === KEY || event.key === null) {
      unpersistedChoice = undefined;
      setGoogleAnalyticsConsent(hasAnalyticsConsent(store()));
    }
  });

  const saved = store();
  setGoogleAnalyticsConsent(hasAnalyticsConsent(saved));
  if (!saved.ts || (saved.performance === true && !hasAnalyticsConsent(saved))) show();
</script>

<style>
  .cc-root {
    position: fixed;
    inset: auto auto 1.25rem 1.25rem;
    z-index: 160;
  }

  .cc-card {
    position: relative;
    width: min(384px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.4rem 1.4rem 1.3rem;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(26px) scale(0.98);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }

  [data-open='true'] .cc-card {
    opacity: 1;
    transform: none;
  }

  .cc-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.8rem;
  }

  .cc-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .cc-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .cc-text {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--marble-dim);
  }

  .cc-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.76rem;
    color: var(--marble-faint);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.3s var(--ease-out);
  }

  .cc-link:hover {
    color: var(--link);
  }

  .cc-actions {
    display: flex;
    gap: 0.55rem;
    margin-top: 1.1rem;
    flex-wrap: wrap;
  }

  .cc-btn {
    flex: 1;
    padding: 0.62rem 0.9rem;
    border-radius: 99px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.35s var(--ease-out);
    white-space: nowrap;
  }

  .cc-btn.ghost {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--marble-dim);
  }

  .cc-btn.ghost:hover {
    border-color: var(--accent);
    color: var(--link);
  }

  .cc-btn.solid {
    background: var(--accent);
    border: 1px solid var(--accent);
    color: var(--marble);
  }

  .cc-btn.solid:hover {
    background: var(--link);
    border-color: var(--link);
  }

  .cc-cats {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-bottom: 0.4rem;
  }

  .cc-cat {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out);
  }

  .cc-cat:hover {
    border-color: rgba(72, 167, 126, 0.5);
  }

  .cc-copy {
    display: grid;
    gap: 0.15rem;
  }

  .cc-copy strong {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cc-copy small {
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--marble-faint);
  }

  .cc-cat input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cc-switch {
    width: 34px;
    height: 19px;
    border-radius: 99px;
    background: rgba(244, 245, 246, 0.14);
    position: relative;
    transition: background 0.3s var(--ease-out);
    flex-shrink: 0;
  }

  .cc-switch i {
    position: absolute;
    top: 2.5px;
    left: 2.5px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--marble-dim);
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  input:checked ~ .cc-switch {
    background: rgba(72, 167, 126, 0.35);
  }

  input:checked ~ .cc-switch i {
    transform: translateX(15px);
    background: var(--link);
  }

  input:disabled ~ .cc-switch {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
