---
import { companyVatNumber, nav, offices } from '../data/site.js';
import { localizePath, navLabel, type Locale } from '../data/i18n';

const { locale }: { locale: Locale } = Astro.props;
const copy = {
  en: {
    next: 'Your next event starts here', create: 'Let’s create', network: 'Part of ONE Event, the global DMC network',
    nav: 'Footer', sitemap: 'Sitemap', legal: 'Legislation', registration: 'Registration No.', vat: 'VAT No.',
    follow: 'Follow us', cookies: 'Cookie settings', rights: 'All rights reserved', privacy: 'Privacy Policy',
    GR: 'Greece', CY: 'Cyprus',
  },
  el: {
    next: 'Η επόμενη εκδήλωσή σας ξεκινά εδώ', create: 'Ας δημιουργήσουμε μαζί', network: 'Μέλος του διεθνούς δικτύου DMC της ONE Event',
    nav: 'Υποσέλιδο', sitemap: 'Χάρτης ιστοτόπου', legal: 'Νομικά στοιχεία', registration: 'Αρ. εγγραφής', vat: 'Αρ. ΦΠΑ',
    follow: 'Ακολουθήστε μας', cookies: 'Ρυθμίσεις cookies', rights: 'Με επιφύλαξη παντός δικαιώματος', privacy: 'Πολιτική απορρήτου',
    GR: 'Ελλάδα', CY: 'Κύπρος',
  },
  es: {
    next: 'Tu próximo evento empieza aquí', create: 'Hagámoslo realidad', network: 'Parte de ONE Event, la red global de DMC',
    nav: 'Pie de página', sitemap: 'Mapa del sitio', legal: 'Datos legales', registration: 'N.º de registro', vat: 'N.º de IVA',
    follow: 'Síguenos', cookies: 'Configuración de cookies', rights: 'Todos los derechos reservados', privacy: 'Política de privacidad',
    GR: 'Grecia', CY: 'Chipre',
  },
}[locale];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-cta">
    <p class="eyebrow" data-reveal>{copy.next}</p>
    <a class="cta-link display-lg" href={localizePath('/get-in-touch/', locale)} data-magnetic>
      {copy.create}
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="footer-grid wrap">
    <div>
      <h2 class="foot-title">One Event</h2>
      <p class="foot-line">One Event Greece &amp; Cyprus</p>
      {offices.map((o) => (
        <p class="foot-line"><strong>{copy[o.countryCode as "GR" | "CY"]}:</strong> {o.address}</p>
      ))}
      <a class="foot-link" href="https://one-event.net/our-destinations/greece/">{copy.network}</a>
    </div>
    <nav aria-label={copy.nav}>
      <h2 class="foot-title">{copy.sitemap}</h2>
      {nav.map((item) => (
        <a class="foot-link" href={localizePath(item.href, locale)}>{navLabel(item, locale)}</a>
      ))}
    </nav>
    <div>
      <h2 class="foot-title">{copy.legal}</h2>
      <p class="foot-line">Customice DMC Travel Ltd</p>
      <p class="foot-line">{copy.registration}: HE423210</p>
      <p class="foot-line">{copy.vat}: {companyVatNumber}</p>
    </div>
    <div>
      <h2 class="foot-title">{copy.follow}</h2>
      <a class="foot-link" href="https://www.linkedin.com/company/one-event" rel="noopener" target="_blank">LinkedIn ↗</a>
      <button class="foot-link cc-open" type="button" data-open-cookies>{copy.cookies}</button>
    </div>
  </div>

  <div class="footer-base-band">
    <div class="footer-base wrap">
      <p>© {year} One Event Greece &amp; Cyprus — {copy.rights}</p>
      <a href={localizePath('/privacy-policy/', locale)}>{copy.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Dark closing band: scope the palette tokens locally so every
       text/border rule in the footer resolves light-on-dark. */
    --marble: #f4f6f5;
    --marble-dim: rgba(244, 246, 245, 0.68);
    --marble-faint: rgba(244, 246, 245, 0.55);
    --line: rgba(244, 246, 245, 0.14);
    --accent: #5cc296;
    background:
      radial-gradient(70% 120% at 50% 0%, rgba(72, 167, 126, 0.14), transparent 55%),
      #2b2d34;
    border-top: 1px solid var(--line);
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .footer-cta {
    padding-bottom: clamp(3.5rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--line);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    color: var(--marble);
    transition: color 0.45s var(--ease-out);
  }

  .cta-link:hover {
    color: var(--link);
  }

  .cta-arrow {
    font-family: var(--font-body);
    font-size: 0.55em;
    transition: transform 0.5s var(--ease-out);
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(12px);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .foot-title {
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
    color: var(--marble);
  }

  .foot-line {
    font-size: 0.88rem;
    color: var(--marble-dim);
    line-height: 1.8;
  }

  .foot-link {
    display: block;
    font-size: 0.88rem;
    color: var(--marble-dim);
    padding-block: 0.28rem;
    transition: color 0.3s var(--ease-out), padding-left 0.35s var(--ease-out);
  }

  .foot-link:hover {
    color: var(--link);
    padding-left: 6px;
  }

  button.cc-open {
    background: none;
    border: 0;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    width: fit-content;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding-block: 1.75rem;
    font-size: 0.78rem;
    color: #000;
  }

  .footer-base-band {
    background: #48a77e;
  }

  .footer-base a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
