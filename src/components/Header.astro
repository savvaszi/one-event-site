---
import { nav } from '../data/site.js';
import { englishPath, headerCopy, languages, localizePath, navLabel, type Locale } from '../data/i18n';

const { locale }: { locale: Locale } = Astro.props;
const copy = headerCopy[locale];
const route = englishPath(Astro.url.pathname);
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href={localizePath('/', locale)} aria-label={`One Event — ${copy.home}`}>
      <img src="/One_event_logo_black.png" alt="One Event" class="brand-logo" />
    </a>
    <nav class="desktop-nav" aria-label={copy.primary}>
      {nav.map((item) => (
        <a
          href={localizePath(item.href, locale)}
          class="nav-link"
          data-magnetic
          aria-current={route === item.href ? 'page' : undefined}
        >
          {navLabel(item, locale)}
        </a>
      ))}
    </nav>
    <div class="header-controls">
      <nav class="language-switch" aria-label={copy.language}>
        {languages.map(({ code, name }) => (
          <a href={localizePath(route, code)} lang={code} hreflang={code} aria-label={name} aria-current={locale === code ? 'page' : undefined}>
            {code.toUpperCase()}
          </a>
        ))}
      </nav>
      <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-label">{copy.menu}</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-lenis-prevent hidden>
    <nav aria-label={copy.mobile}>
      {nav.map((item, i) => (
        <a href={localizePath(item.href, locale)} class="mobile-link">
          <span class="mobile-index">0{i + 1}</span>
          {navLabel(item, locale)}
        </a>
      ))}
    </nav>
    <p class="mobile-foot">One Event Greece &amp; Cyprus · DMC Travel Ltd</p>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: background 0.5s var(--ease-out), backdrop-filter 0.5s var(--ease-out);
  }

  .site-header[data-scrolled] {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    width: min(1440px, calc(100% - var(--gutter) * 2));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1rem, 2.2vw, 1.75rem);
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand-logo {
    height: clamp(28px, 4vw, 42px);
    width: auto;
    filter: none;
  }

  .desktop-nav {
    display: flex;
    gap: clamp(0.8rem, 1.5vw, 2rem);
  }

  .header-controls, .language-switch {
    display: flex;
    align-items: center;
  }

  .header-controls {
    gap: clamp(0.45rem, 2vw, 1.25rem);
  }

  .language-switch {
    gap: 0.15rem;
  }

  .language-switch a {
    display: grid;
    place-items: center;
    min-width: 28px;
    min-height: 32px;
    font-size: 0.75rem;
    color: var(--marble-dim);
  }

  .language-switch a:hover,
  .language-switch a[aria-current='page'] {
    color: var(--marble);
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  .nav-link {
    position: relative;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marble-dim);
    transition: color 0.35s var(--ease-out);
    padding-block: 0.4rem;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--marble);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--marble);
    cursor: pointer;
    align-items: center;
    gap: 0.7rem;
  }

  .menu-label {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .menu-icon {
    display: grid;
    gap: 6px;
    width: 26px;
  }

  .menu-icon i {
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }

  [aria-expanded='true'] .menu-icon i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  [aria-expanded='true'] .menu-icon i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--sea);
    display: none;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    padding: 5.5rem var(--gutter) 1.5rem;
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 7vw, 3.5rem);
    line-height: 1.25;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    opacity: 0;
    transform: translateY(24px);
  }

  .mobile-index {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.2em;
  }

  .mobile-foot {
    margin-top: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marble-faint);
  }

  @media (max-width: 1120px) {
    .desktop-nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  :global(.menu-open) {
    overflow: hidden;
  }

  :global(.menu-open) .mobile-menu {
    display: flex;
  }

  :global(.menu-open) .mobile-link {
    animation: rise 0.7s var(--ease-out) forwards;
  }

  :global(.menu-open) .mobile-link:nth-child(2) {
    animation-delay: 0.07s;
  }

  :global(.menu-open) .mobile-link:nth-child(3) {
    animation-delay: 0.14s;
  }

  :global(.menu-open) .mobile-link:nth-child(4) {
    animation-delay: 0.21s;
  }

  :global(.menu-open) .mobile-link:nth-child(5) {
    animation-delay: 0.28s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('#mobile-menu')!;
  const mobile = matchMedia('(max-width: 1120px)');

  addEventListener('scroll', () => {
    if (scrollY > 40) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  }, { passive: true });

  const setMenuOpen = (open: boolean) => {
    document.documentElement.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };

  const menuIsOpen = () => toggle.getAttribute('aria-expanded') === 'true';
  const closeMenu = () => setMenuOpen(false);

  toggle.addEventListener('click', () => setMenuOpen(!menuIsOpen()));

  mobile.addEventListener('change', ({ matches }) => {
    if (!matches && menuIsOpen()) {
      if (document.activeElement === toggle || menu.contains(document.activeElement)) {
        header.querySelector<HTMLElement>('.brand')?.focus();
      }
      closeMenu();
    }
  });

  document.addEventListener('focusin', (event) => {
    if (menuIsOpen() && event.target instanceof Node && !header.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuIsOpen()) {
      closeMenu();
      toggle.focus();
    }
  });

  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>
