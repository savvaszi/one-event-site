---
interface Props {
  entries: { title: string }[];
}

const { entries } = Astro.props;
---

<div class="reference-ticker" role="region" aria-label="More event references" tabindex="0" data-lenis-prevent-horizontal>
  <ul role="list">
    {entries.map(({ title }) => <li>{title}</li>)}
  </ul>
</div>

<style>
  .reference-ticker {
    overflow-x: auto;
    border-block: 1px solid var(--line);
  }

  .reference-ticker:focus-visible {
    outline-offset: -3px;
  }

  ul {
    display: flex;
    width: max-content;
    padding: 1.4rem var(--gutter);
    list-style: none;
  }

  li {
    padding-inline: 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    color: var(--marble-dim);
  }

  li:first-child {
    padding-inline-start: 0;
  }

  li + li {
    border-inline-start: 1px solid var(--line);
  }
</style>
