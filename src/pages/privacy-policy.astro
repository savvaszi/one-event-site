---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy | One Event">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="display-lg" data-split>Privacy Policy</h1>
    </div>
  </section>

  <article class="policy wrap prose">
    <h2>Overview</h2>
    <p>
      This website uses cookies to improve your experience while you navigate through the website.
      Cookies categorised as necessary are stored on your browser as they are essential for the
      working of basic functionalities. We also use third-party cookies that help us analyse and
      understand how you use this website. These cookies will be stored in your browser only with
      your consent. You may opt out — opting out of some cookies may affect your browsing experience.
    </p>

    <h2>Managing consent</h2>
    <p>
      You can review, change or withdraw your consent at any time via the
      <strong>Cookie settings</strong> link in the footer of every page. Rejecting optional
      categories keeps only the strictly necessary cookies enabled. Your choices are stored in
      your browser and are not shared with third parties by this site itself.
    </p>

    <h2>Necessary</h2>
    <p>
      Necessary cookies are absolutely essential for the website to function properly. They ensure
      basic functionalities and security features, anonymously.
    </p>

    <h2>Functional</h2>
    <p>
      Functional cookies help perform functionalities like sharing content on social media
      platforms, collecting feedback and other third-party features.
    </p>

    <h2>Performance &amp; Analytics</h2>
    <p>
      Analytical cookies understand and analyse key performance indexes of the website, helping
      deliver a better visitor experience.
    </p>

    <h2>Data controller</h2>
    <p>
      Customice DMC Travel Ltd · Registration No.: HE423210 · VAT No.: 10423210U<br />
      Greece: 20 Dinocharous Street, 11852, Athens · Cyprus: 10 Delfon Street, 1101, Nicosia
    </p>
  </article>

  <style>
    .page-hero {
      padding-block: clamp(10rem, 22vh, 14rem) clamp(3rem, 7vw, 5rem);
      background: var(--sea);
      border-bottom: 1px solid var(--line);
    }

    .prose {
      max-width: 72ch;
      padding-block: clamp(4rem, 9vw, 7rem);
    }

    .prose h2 {
      font-size: clamp(1.4rem, 2.4vw, 1.9rem);
      margin-block: 2.2rem 0.8rem;
    }

    .prose p {
      color: var(--marble-dim);
    }
  </style>
</BaseLayout>
