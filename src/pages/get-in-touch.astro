---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contacts, destinations, offices } from '../data/site.js';

const heroImage = '/img/get-in-touch.jpg';
---

<BaseLayout title="Get in Touch | One Event" description="Contact One Event Greece & Cyprus — Athens and Nicosia offices.">
  <section class="c-hero">
    <div class="wrap c-grid">
      <div>
        <p class="eyebrow">Greece &amp; Cyprus Hub</p>
        <h1 class="display-lg" data-split>Let’s talk about<br />your <em>next event</em></h1>

        {contacts.map((person) => (
          <article class="contact-card" data-reveal>
            <h2>{person.name}</h2>
            <p class="role">{person.role}</p>
            <a class="contact-line mail" href={`mailto:${person.email}`}>{person.email}</a>
            {person.phones.map((p) => (
              <a class="contact-line" href={`tel:${p.replace(/[^+\d]/g, '')}`}>{p}</a>
            ))}
          </article>
        ))}
      </div>
      <figure class="media-mask c-photo" data-reveal>
        <img src={heroImage} alt="One Event — get in touch" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="brief" id="brief" aria-labelledby="brief-title">
    <div class="wrap brief-grid">
      <div class="brief-intro">
        <p class="eyebrow">Your event brief</p>
        <h2 class="display-md" id="brief-title" data-split>Tell us what you’re planning</h2>
        <p>Share the essentials and prepare a structured email to our team. You can review everything before sending.</p>
        <p class="brief-note">Nothing is stored or sent by this page. The button opens your email app; you can also email us directly above.</p>
      </div>
      <form class="brief-form" id="brief-form">
        <div class="field-row">
          <label>Name<input type="text" name="name" autocomplete="name" required /></label>
          <label>Work email<input type="email" name="email" autocomplete="email" required /></label>
        </div>
        <div class="field-row">
          <label>Preferred dates<input type="text" name="dates" placeholder="e.g. 12–15 May 2027" /></label>
          <label>Destination
            <select name="destination">
              <option value="Not decided">Not decided</option>
              {destinations.map((destination) => <option>{destination.name}</option>)}
              <option>Another destination in Greece</option>
            </select>
          </label>
        </div>
        <label>Estimated guests<input type="number" name="guests" min="1" inputmode="numeric" placeholder="e.g. 120" /></label>
        <label>What would you like to create?<textarea name="details" rows="5" required placeholder="Event type, goals, venues or experiences you have in mind"></textarea></label>
        <button class="btn" type="submit">Prepare email <span class="arrow" aria-hidden="true">→</span></button>
        <p class="form-status" id="brief-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="offices">
    <div class="wrap office-grid">
      {offices.map((o) => (
        <div class="office-card" id={o.id} data-reveal>
          <h3>{o.country}</h3>
          <p>{o.address}</p>
        </div>
      ))}
    </div>
  </section>

  <style>
    .c-hero {
      padding-block: clamp(10rem, 22vh, 14rem) clamp(3.5rem, 8vw, 6rem);
      background:
        radial-gradient(55% 70% at 90% 5%, rgba(72,167,126,.12), transparent 65%),
        var(--sea);
      border-bottom: 1px solid var(--line);
    }

    .c-hero em {
      font-style: italic;
      color: var(--link);
    }

    .c-grid {
      display: grid;
      grid-template-columns: 1fr minmax(280px, 460px);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }

    .contact-card {
      margin-top: clamp(1.75rem, 4vw, 2.75rem);
      padding-top: 1.4rem;
      border-top: 1px solid var(--line);
    }

    .contact-card h2 {
      font-size: clamp(1.5rem, 2.6vw, 2rem);
    }

    .role {
      color: var(--link);
      font-size: 0.74rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      margin: 0.4rem 0 0.9rem;
    }

    .contact-line {
      display: block;
      width: fit-content;
      font-size: 0.95rem;
      color: var(--marble-dim);
      padding-block: 0.25rem;
      transition: color .35s var(--ease-out), transform .35s var(--ease-out);
    }

    .contact-line:hover {
      color: var(--link);
      transform: translateX(6px);
    }

    .mail {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    .c-photo {
      aspect-ratio: 4 / 5;
      border-radius: 14px;
    }

    .c-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brief {
      scroll-margin-top: 5rem;
      padding-block: clamp(4rem, 9vw, 7rem);
      border-bottom: 1px solid var(--line);
    }

    .brief-grid {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
      gap: clamp(2.5rem, 7vw, 7rem);
      align-items: start;
    }

    .brief-intro > p:not(.eyebrow) {
      max-width: 46ch;
      margin-top: 1.5rem;
      color: var(--marble-dim);
    }

    .brief-intro .brief-note {
      font-size: .86rem;
    }

    .brief-form {
      display: grid;
      gap: 1.25rem;
    }

    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .brief-form label {
      display: grid;
      gap: .5rem;
      font-size: .8rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .brief-form input,
    .brief-form select,
    .brief-form textarea {
      width: 100%;
      min-height: 48px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--sea);
      color: var(--marble);
      font: 1rem/1.5 var(--font-body);
      letter-spacing: normal;
      text-transform: none;
      padding: .8rem 1rem;
    }

    .brief-form textarea {
      resize: vertical;
    }

    .brief-form input:focus,
    .brief-form select:focus,
    .brief-form textarea:focus {
      border-color: var(--accent);
    }

    .brief-form .btn {
      width: fit-content;
      background: transparent;
      cursor: pointer;
    }

    .form-status {
      min-height: 1.65rem;
      color: var(--link);
      font-size: .9rem;
    }

    .offices {
      padding-block: clamp(4rem, 9vw, 7rem);
    }

    .office-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .office-card {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: clamp(1.75rem, 4vw, 2.75rem);
      scroll-margin-top: 6rem;
      transition: border-color .45s var(--ease-out), transform .45s var(--ease-out);
    }

    .office-card:hover {
      border-color: var(--accent);
      transform: translateY(-5px);
    }

    .office-card h3 {
      font-size: clamp(1.4rem, 2.4vw, 1.9rem);
      margin-bottom: 0.5rem;
    }

    .office-card p {
      color: var(--marble-dim);
    }

    @media (max-width: 800px) {
      .brief-grid,
      .field-row {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const form = document.querySelector<HTMLFormElement>('#brief-form')!;
    const status = document.querySelector<HTMLElement>('#brief-status')!;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) || 'Not provided');
      const subject = `Proposal request — ${value('destination')} — ${value('name')}`;
      const body = [
        `Name: ${value('name')}`,
        `Reply email: ${value('email')}`,
        `Preferred dates: ${value('dates')}`,
        `Destination: ${value('destination')}`,
        `Estimated guests: ${value('guests')}`,
        '',
        'Event brief:',
        value('details'),
      ].join('\n');

      status.textContent = 'Your email app should open now with the brief ready to review and send.';
      window.location.href = `mailto:aonoufriou@one-event.net?cc=donoufriou@one-event.net&subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
