---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { destinations } from '../../data/site.js';

const globalNetwork = 'https://one-event.net/';
---

<BaseLayout title="Our Destinations | One Event" description="Explore our destinations in Greece and Cyprus â€” Athens, Crete, Cyprus, Mykonos, Peloponnese and Santorini.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Our destinations</p>
      <h1 class="display-lg" data-split>Anywhere. Anytime.<br />Plus the entire <em>world</em></h1>
      <p class="page-lede" data-reveal>
        We provide our services anywhere and at anytime â€” starting from our home destinations in
        Greece &amp; Cyprus.
      </p>
    </div>
  </section>

  <section class="dest-list" aria-label="Home destinations">
    <div class="wrap dest-grid">
      {destinations.map((d) => (
        <a class="dest-card media-mask" href={`/destinations/${d.slug}/`} data-reveal>
          <img src={d.image} alt={`${d.name} â€” One Event destination`} loading="lazy" />
          <div class="dest-meta">
            <h2 class="dest-name">{d.name}</h2>
            <p class="dest-tag">{d.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="network">
    <div class="wrap network-inner">
      <h2 class="display-md" data-split>Beyond home shores</h2>
      <p data-reveal>Through One Eventâ€™s global network we deliver the same standard worldwide.</p>
      <a class="btn" href={globalNetwork} target="_blank" rel="noopener" data-magnetic data-reveal>
        Explore our global network <span class="arrow">â†’</span>
      </a>
    </div>
  </section>

  <style>
    .page-hero {
      padding-block: clamp(10rem, 22vh, 14rem) clamp(3rem, 7vw, 6rem);
      background:
        radial-gradient(55% 75% at 15% 0%, rgba(253,154,107,.12), transparent 65%),
        var(--sea);
      border-bottom: 1px solid var(--line);
    }

    .page-hero em {
      font-style: italic;
      color: var(--accent-bright);
    }

    .page-lede {
      margin-top: 1.5rem;
      color: var(--marble-dim);
      max-width: 52ch;
    }

    .dest-list {
      padding-block: clamp(4rem, 9vw, 8rem);
    }

    .dest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
      gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }

    .dest-card {
      position: relative;
      aspect-ratio: 16 / 11;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      border-radius: 14px;
    }

    .dest-card img {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .dest-card::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(180deg, transparent 45%, rgba(14,16,19,.9));
      transition: opacity .5s var(--ease-out);
    }

    .dest-meta {
      padding: clamp(1.25rem, 3vw, 2rem);
      transform: translateY(6px);
      transition: transform .5s var(--ease-out);
    }

    .dest-card:hover .dest-meta {
      transform: translateY(0);
    }

    .dest-name {
      font-size: clamp(1.8rem, 3vw, 2.4rem);
    }

    .dest-tag {
      font-size: 0.85rem;
      color: var(--marble-dim);
      margin-top: 0.35rem;
    }

    .network {
      background: var(--sea);
      border-top: 1px solid var(--line);
      padding-block: clamp(4.5rem, 10vw, 8rem);
    }

    .network-inner {
      text-align: center;
      display: grid;
      justify-items: center;
      gap: 1.4rem;
    }

    .network p {
      color: var(--marble-dim);
      max-width: 48ch;
    }
  </style>
</BaseLayout>
