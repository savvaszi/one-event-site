---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';
---

<BaseLayout title="Projects | One Event" description="Project case studies by One Event Greece & Cyprus — the work, in pictures.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Projects</p>
      <h1 class="display-lg" data-split>The work, <em>in pictures</em></h1>
    </div>
  </section>

  <section class="proj-list" aria-label="Projects">
    <div class="wrap proj-grid">
      {projects.map((p) => (
        <a class="proj-card" href={`/projects/${p.slug}/`} data-reveal>
          <div class="proj-card-media">
            <img src={p.cover} alt={`${p.title} — highlight photograph`} loading="lazy" decoding="async" />
          </div>
          <div class="proj-card-body">
            <h2 class="proj-card-title">{p.title}</h2>
            <p class="proj-card-meta">{[p.location, p.dates].filter(Boolean).join(' · ')}</p>
            <span class="proj-card-cta">View project →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <style>
    .page-hero {
      padding-block: clamp(10rem, 22vh, 14rem) clamp(3rem, 7vw, 6rem);
      background:
        radial-gradient(55% 75% at 85% 0%, rgba(72,167,126,.12), transparent 65%),
        var(--sea);
      border-bottom: 1px solid var(--line);
    }

    .page-hero em {
      font-style: italic;
      color: var(--link);
    }

    .proj-list {
      padding-block: clamp(4rem, 9vw, 7rem);
    }

    .proj-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .proj-card {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color .45s var(--ease-out), transform .45s var(--ease-out);
    }

    .proj-card:hover {
      border-color: var(--accent);
      transform: translateY(-5px);
    }

    .proj-card-media {
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }

    .proj-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 20%;
      transition: scale 1s var(--ease-out);
    }

    .proj-card:hover .proj-card-media img {
      scale: 1.05;
    }

    .proj-card-body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: clamp(1.2rem, 2.4vw, 1.8rem);
    }

    .proj-card-title {
      font-family: var(--font-display);
      font-size: clamp(1.3rem, 2.2vw, 1.8rem);
      line-height: 1.05;
    }

    .proj-card-meta {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--marble-dim);
    }

    .proj-card-cta {
      margin-top: 0.6rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--link-text);
    }
  </style>
</BaseLayout>
