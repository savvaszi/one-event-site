---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';
import { destinations } from '../../data/site.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const destination = destinations.find((item) => item.project === p.slug);
const metaLine = [p.location, p.dates, p.guests].filter(Boolean).join(' · ');
---

<BaseLayout title={`${p.title} | One Event`} description={p.summary}>
  <section class="proj-hero">
    <div class="proj-hero-media">
      <img src={p.cover} alt={`${p.title} — highlight photograph`} fetchpriority="high" />
      <div class="proj-hero-scrim"></div>
    </div>
    <div class="wrap proj-hero-content">
      <p class="eyebrow">{p.client}</p>
      <h1 class="display-lg" data-split>{p.title}</h1>
      {metaLine && <p class="proj-meta">{metaLine}</p>}
    </div>
  </section>

  <section class="proj-body">
    <div class="wrap">
      <div class="proj-facts" data-reveal>
        {p.location && <div class="fact"><span class="fact-k">Location</span><span class="fact-v">{p.location}</span></div>}
        {p.dates && <div class="fact"><span class="fact-k">Dates</span><span class="fact-v">{p.dates}</span></div>}
        {p.guests && <div class="fact"><span class="fact-k">Guests</span><span class="fact-v">{p.guests}</span></div>}
        {p.photographer && <div class="fact"><span class="fact-k">Photography</span><span class="fact-v">{p.photographer}</span></div>}
        {p.video && <a class="fact fact-link" href={p.video} target="_blank" rel="noopener">Watch the film →</a>}
      </div>
      <div class="proj-text">
        {p.body.map((para) => <p data-reveal>{para}</p>)}
      </div>
    </div>
  </section>

  <section class="proj-gallery" aria-label={`${p.title} gallery`}>
    <div class="wrap">
      <h2 class="display-md" data-split>The gallery</h2>
      <div class="gal-grid">
        {p.gallery.map((src, i) => (
          <button
            class="gal-item"
            type="button"
            data-full={src}
            data-caption={`${p.title} — photo ${i + 1} of ${p.gallery.length}`}
          >
            <img src={src} alt={`${p.title} photograph ${i + 1}`} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="proj-nav">
    <div class="wrap proj-nav-inner">
      <a href="/projects/">← All projects</a>
      {destination && <a href={`/destinations/${destination.slug}/`}>Explore {destination.name} →</a>}
      <a href="/references/">References</a>
    </div>
  </section>

  <div class="lightbox" hidden>
    <div class="lightbox-backdrop"></div>
    <figure class="lightbox-figure">
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <button class="lightbox-prev" type="button" aria-label="Previous photo">‹</button>
      <img class="lightbox-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" />
      <button class="lightbox-next" type="button" aria-label="Next photo">›</button>
      <figcaption class="lightbox-caption" aria-live="polite"></figcaption>
    </figure>
  </div>

  <style>
    .proj-hero {
      position: relative;
      min-height: 72svh;
      display: grid;
      align-items: end;
      overflow: clip;
    }

    .proj-hero-media {
      position: absolute;
      inset: 0;
    }

    .proj-hero-media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 30%;
    }

    .proj-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,.25) 0%, rgba(255,255,255,.72) 62%, rgba(255,255,255,.94) 100%);
    }

    .proj-hero-content {
      position: relative;
      z-index: 1;
      padding-block: clamp(3rem, 8vh, 5rem);
    }

    .proj-meta {
      margin-top: 1.25rem;
      font-size: 0.82rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--marble-dim);
    }

    .proj-body {
      padding-block: clamp(3.5rem, 8vw, 6rem);
    }

    .proj-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2.5rem;
      padding-block: 1.4rem;
      border-block: 1px solid var(--line);
      margin-bottom: clamp(2.5rem, 5vw, 4rem);
    }

    .fact {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 120px;
    }

    .fact-k {
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--marble-faint);
    }

    .fact-v {
      font-family: var(--font-display);
      font-size: 1.15rem;
    }

    .fact-link {
      align-self: center;
      color: var(--link);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .proj-text {
      max-width: 68ch;
      display: grid;
      gap: 1.4rem;
      font-size: 1.08rem;
      line-height: 1.75;
      color: var(--marble-dim);
    }

    .proj-text p:first-child {
      color: var(--marble);
      font-size: clamp(1.2rem, 2.2vw, 1.5rem);
      line-height: 1.5;
    }

    .proj-gallery {
      padding-block: clamp(3rem, 7vw, 5rem);
      border-top: 1px solid var(--line);
    }

    .gal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
      gap: clamp(0.8rem, 1.6vw, 1.4rem);
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .gal-item {
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
      background: none;
      aspect-ratio: 4 / 3;
      cursor: zoom-in;
      transition: border-color .4s var(--ease-out);
    }

    .gal-item:hover {
      border-color: var(--accent);
    }

    .gal-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 22%;
      transition: scale 0.9s var(--ease-out);
    }

    .gal-item:hover img {
      scale: 1.05;
    }

    .proj-nav {
      border-top: 1px solid var(--line);
    }

    .proj-nav-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.6rem 1.5rem;
      padding-block: 1.6rem;
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .proj-nav-inner a {
      color: var(--marble-dim);
      transition: color .3s var(--ease-out);
    }

    .proj-nav-inner a:hover {
      color: var(--link);
    }

    /* Lightbox */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: grid;
      place-items: center;
    }

    .lightbox[hidden] {
      display: none;
    }

    .lightbox-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(10, 16, 19, 0.92);
      cursor: zoom-out;
    }

    .lightbox-figure {
      position: relative;
      z-index: 1;
      margin: 0;
      max-width: min(92vw, 1400px);
      display: grid;
      justify-items: center;
      gap: 0.9rem;
    }

    .lightbox-img {
      max-width: 100%;
      max-height: 78vh;
      width: auto;
      height: auto;
      border-radius: 4px;
    }

    .lightbox-caption {
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.72);
    }

    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      position: absolute;
      background: none;
      border: 0;
      color: #fff;
      font-size: 2rem;
      line-height: 1;
      padding: 0.6rem;
      cursor: pointer;
      opacity: 0.75;
      transition: opacity .3s var(--ease-out);
    }

    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {
      opacity: 1;
    }

    .lightbox-close {
      top: -3rem;
      right: 0;
    }

    .lightbox-prev {
      left: -3.2rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox-next {
      right: -3.2rem;
      top: 50%;
      transform: translateY(-50%);
    }

    @media (max-width: 900px) {
      .lightbox-prev { left: 0.2rem; }
      .lightbox-next { right: 0.2rem; }
      .lightbox-close { top: 0.2rem; right: 0.2rem; }
    }
  </style>

  <script>
    const items = [...document.querySelectorAll<HTMLElement>('.gal-item')];
    const box = document.querySelector<HTMLElement>('.lightbox');
    if (box && items.length) {
      const img = box.querySelector<HTMLImageElement>('.lightbox-img')!;
      const caption = box.querySelector<HTMLElement>('.lightbox-caption')!;
      const closeBtn = box.querySelector<HTMLButtonElement>('.lightbox-close')!;
      const prevBtn = box.querySelector<HTMLButtonElement>('.lightbox-prev')!;
      const nextBtn = box.querySelector<HTMLButtonElement>('.lightbox-next')!;
      const backdrop = box.querySelector<HTMLElement>('.lightbox-backdrop')!;
      let idx = 0;
      let opener: HTMLElement | null = null;

      const show = (i: number) => {
        idx = (i + items.length) % items.length;
        const it = items[idx];
        img.src = it.dataset.full || '';
        img.alt = it.querySelector('img')?.alt || '';
        caption.textContent = it.dataset.caption || '';
      };

      const open = (i: number, trigger: HTMLElement) => {
        opener = trigger;
        show(i);
        box.hidden = false;
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      };

      const close = () => {
        box.hidden = true;
        img.src = '';
        document.body.style.overflow = '';
        opener?.focus();
      };

      items.forEach((it, i) => it.addEventListener('click', () => open(i, it)));
      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      prevBtn.addEventListener('click', () => show(idx - 1));
      nextBtn.addEventListener('click', () => show(idx + 1));
      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(idx - 1);
        else if (e.key === 'ArrowRight') show(idx + 1);
      });
    }
  </script>
</BaseLayout>
