---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceTicker from '../components/ReferenceTicker.astro';
import { references, gallery } from '../data/site.js';

// Project-linked cases first, then the rest, capped at eight rows.
const featured = [
  ...references.filter((r) => r.project),
  ...references.filter((r) => !r.project),
].slice(0, 8);
const otherReferences = references.filter((reference) => !featured.includes(reference));
---

<BaseLayout title="References | One Event" description="Highlighted cases by One Event Greece & Cyprus — conferences, incentives and gala events for the world's finest brands.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">References</p>
      <h1 class="display-lg" data-split>Some of our<br />highlighted <em>cases</em></h1>
    </div>
  </section>

  <section class="cases" aria-label="Highlighted cases">
    <div class="wrap case-list">
      {featured.map((r) => (
        <div class="case-row" data-reveal>
          {r.project ? (
            <a class="case-title" href={`/projects/${r.project}/`}>{r.title}</a>
          ) : (
            <span class="case-title">{r.title}</span>
          )}
          <span class="case-meta">{r.meta}</span>
          {r.video && (
            <a class="case-play" href={r.video} target="_blank" rel="noopener" aria-label={`Watch the film: ${r.title}`}>▶ Watch</a>
          )}
          {r.project && <a class="case-project" href={`/projects/${r.project}/`}>Photos →</a>}
        </div>
      ))}
    </div>
  </section>

  <section class="moments" aria-label="Moments from our events">
    <div class="wrap">
      <p class="eyebrow">Moments</p>
      <h2 class="display-md" data-split>Frames from the field</h2>
      <div class="moment-grid">
        {gallery.map((g) => (
          <figure class="media-mask moment-card" data-reveal>
            <img src={g.src} alt={g.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="more">
    <div class="wrap more-inner">
      <h2 class="display-md" data-split>24 productions and counting</h2>
      <p data-reveal>Conferences, incentives, gala dinners and team experiences across Greece &amp; Cyprus.</p>
    </div>
    <ReferenceTicker entries={otherReferences} />
  </section>

  <style>
    .page-hero {
      padding-block: clamp(10rem, 22vh, 14rem) clamp(3rem, 7vw, 6rem);
      background:
        radial-gradient(55% 75% at 85% 0%, rgba(72,167,126,.12), transparent 65%),
        var(--sea);
      border-bottom: 1px solid var(--line);
    }

    .page-hero em {
      font-style: italic;
      color: var(--link);
    }

    .cases {
      padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
    }

    .case-row {
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      align-items: baseline;
      gap: clamp(1rem, 3vw, 2.5rem);
      padding-block: clamp(1.1rem, 2.4vw, 1.6rem);
      border-bottom: 1px solid var(--line);
      transition: padding-left .45s var(--ease-out), border-color .45s var(--ease-out);
    }

    .case-row:first-child {
      border-top: 1px solid var(--line);
    }

    @media (hover: hover) and (pointer: fine) {
      .case-row:hover {
        padding-left: 14px;
        border-color: var(--accent);
      }
    }

    .case-title {
      font-family: var(--font-display);
      font-size: clamp(1.25rem, 2.6vw, 2.1rem);
      transition: color .35s var(--ease-out);
    }

    .case-row:hover .case-title {
      color: var(--link-text);
    }

    .case-meta {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--marble-dim);
    }

    .case-play,
    .case-project {
      display: inline-flex;
      align-items: center;
      justify-self: start;
      min-height: 44px;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--link-text);
      text-decoration: underline;
      text-underline-offset: 0.25em;
      white-space: nowrap;
      transition: color .35s var(--ease-out);
    }

    .case-play:is(:hover, :focus-visible),
    .case-project:is(:hover, :focus-visible) {
      color: var(--accent-text);
    }

    .moments {
      padding-block: clamp(3rem, 7vw, 5rem);
    }

    .moment-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
      gap: clamp(1rem, 2vw, 1.75rem);
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .moment-card {
      aspect-ratio: 4 / 3;
    }

    .moment-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .more {
      padding-block: clamp(4rem, 9vw, 7rem) 0;
      background:
        radial-gradient(60% 90% at 50% 0%, rgba(72,167,126,.1), transparent 70%);
    }

    .more-inner {
      text-align: center;
      display: grid;
      justify-items: center;
      gap: 1.2rem;
      padding-bottom: clamp(3rem, 7vw, 5rem);
    }

    .more p {
      color: var(--marble-dim);
      max-width: 48ch;
    }

    @media (max-width: 720px) {
      .case-row {
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.3rem 1.25rem;
      }

      .case-title,
      .case-meta {
        grid-column: 1 / -1;
      }
    }
  </style>

</BaseLayout>
